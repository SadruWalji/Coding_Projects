files <- list.files(path='./Data', pattern='^goalies', full.names = TRUE)
data <- files %>%
map_df(read_csv)
data <- data %>%
filter(situation=='all',
games_played >20) %>%
select(season, name, team, goals, icetime, ongoal, xGoals) %>%
mutate(season = as.integer(season),
GAA = as.numeric((goals*3600)/(icetime)),
sv_p = as.numeric(1-goals/ongoal),
xvG_delta = as.numeric(xGoals - goals)) %>%
group_by(season) %>%
mutate(GAA_rank = rank(desc(GAA), ties.method='first'),
sv_p_rank = rank(desc(sv_p), ties.method='first'),
team = recode(team,
'T.B' = 'TBL',
'S.J' = 'SJS',
'N.J' = 'NJD',
'L.A' = 'LAK')
)
team_cols <- read_csv('./Data/team_colours.csv', comment = '')
dat.plot <- merge(data, team_cols, by='team') %>%
ungroup()
metric <- 'GAA'
test1 <- dat.plot %>%
map_df(fun2, metric)
fun2 <- 'slice_max'
test1 <- dat.plot %>%
map_df(fun2, metric)
test1 <- dat.plot %>%
map_df(fun2, GAA)
fun2 <- match.fun('slice_max')
test1 <- dat.plot %>%
map_df(fun2, GAA)
test1 <- dat.plot %>%
map_df(fun2, 'GAA')
test1 <- dat.plot %>%
map_df(min, 'GAA')
View(test1)
test1 <- dat.plot %>%
map_df(slice_max, 'GAA')
fun2 <- match.fun('min')
test1 <- dat.plot %>%
map_df(fun2, 'GAA')
test1 <- dat.plot %>%
map_df(fun2, metric)
fun2 <- match.fun('max')
test1 <- dat.plot %>%
map_df(fun2, metric)
fun2 <- match.fun('min')
