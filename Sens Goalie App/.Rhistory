test1 <- dat.plot %>%
map_df(fun2, metric)
fun2 <- match.fun('max')
fun2 <- match.fun('max')
View(fun2)
test1 <- dat.plot %>%
map_df(fun2, metric)
fun2 <- match.fun('slice_max')
test1 <- fun2(dat.plot, n=5, metric)
test1 <- fun2(dat.plot, n=5, by=metric)
test1 <- fun2(dat.plot, order_by=metric, n=5)
test1 <- fun2(dat.plot, order_by=GAA, n=5)
test1 <- fun2(dat.plot, order_by=!!metric, n=5)
test1 <- fun2(dat.plot, order_by={{metric}}, n=5)
test1 <- fun2(dat.plot, order_by=!!!metric, n=5)
metric <- c('GAA')
test1 <- fun2(dat.plot, order_by=metric, n=5)
metric <- c('GAA','sv_p')
test1 <- fun2(dat.plot, order_by=metric, n=5)
test1 <- fun2(dat.plot, order_by={{metric}}, n=5)
metric <- 'GAA'
fun2 <- match.fun(paste0('slice_',t1))
t1 = 'max'
fun2 <- match.fun(paste0('slice_',t1))
View(fun2)
runApp()
