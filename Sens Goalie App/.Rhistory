metric <- c('GAA', 'GAA','GAA','GAA','GAA')
dat2 <- slice_head(dat.plot, n=5)
test1 <- fun2(dat2, order_by={{metric}}, n=5)
View(test1)
test1 <- fun2(dat2, order_by={{metric}}, n=5)
metric <- 'GAA'
